# Copie para .env (o `flask` o carrega sozinho). Em dev, sem Supabase o login usa o provedor "dev".
SECRET_KEY=troque-por-um-valor-longo-e-aleatorio
# Supabase Auth (Project Settings > API). A chave anon/publishable é pública.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
# AUTH_PROVEDOR=dev   # força o login sem Supabase (só dev; produção o proíbe)
# Produção (Vercel > Settings > Environment Variables): DATABASE_URL, SECRET_KEY, SUPABASE_URL, SUPABASE_ANON_KEY
# DATABASE_URL=postgresql://...   # use a URL do pooler (porta 6543) do Supabase
